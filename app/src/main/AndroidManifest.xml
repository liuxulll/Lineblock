<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lineblock.app">

    <!-- 悬浮窗权限：Android 10 上需要用户手动授予 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务需要 FOREGROUND_SERVICE 权限（API 28+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 震动反馈（长按 1 秒进入拖动模式时使用） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主界面：申请权限 + 提供锁定开关 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 悬浮窗服务：管理悬浮窗 View 的生命周期 -->
        <service
            android:name=".FloatWindowService"
            android:exported="false" />

        <!-- 无障碍服务：用于在系统层面拦截悬浮窗区域的触摸事件
             通过 meta-data 指定配置文件，配置在 res/xml/accessibility_service_config.xml -->
        <service
            android:name=".TouchBlockAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
